<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>UartHub.Tests</AssemblyName>
    <RootNamespace>UartHub.Testing</RootNamespace>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS0414;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../src/UartHub.Core.csproj" />
  </ItemGroup>
  <!-- 비공개 자료(../internal — 공개 저장소에 없음): 있으면 실보드 로그 재생·골든 시나리오와 사내 제품 프로필을 함께 넣는다 -->
  <ItemGroup Condition="Exists('../internal/testing')">
    <Compile Include="../internal/testing/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../internal/fixtures')">
    <!-- US-113 실보드 로그 발췌(사건 감지 재생 시험, internal/testing/Scenarios.Fixtures.cs events-fixtures) -->
    <EmbeddedResource Include="../internal/fixtures/*.log.gz;../internal/fixtures/*.raw.gz;../internal/fixtures/rx_arrow_lines.txt" LogicalName="fixtures/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../internal/profile.json')">
    <EmbeddedResource Include="../internal/profile.json" LogicalName="internal/profile.json" />
  </ItemGroup>
</Project>
