<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- obj/bin 은 소스 트리 밖(artifacts/)으로 뺀다 -->
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <BuildInfoFile>$(MSBuildThisFileDirectory)artifacts/gen/BuildInfo.g.cs</BuildInfoFile>
    <!-- exe·dll 에 빌드한 PC 의 절대 경로(PDB 경로·소스 경로)를 남기지 않는다: 저장소 루트를 /_/ 로 바꿔 적는다 -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=/_/</PathMap>
    <Deterministic>true</Deterministic>
    <Version>0.0.0</Version>
  </PropertyGroup>
</Project>
