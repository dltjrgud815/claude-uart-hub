#!/usr/bin/env bash
# uart — UART 허브 CLI 래퍼 v2(계획 C-7). WSL·Git Bash 에서 Windows 의 `UartHub.exe cli` 를 부른다.
#   사용: uart <명령> [대상] [인자…] [--json …]   (ls status run send probe wait reboot log logpath hub · events aging(읽기만) …
#         · connect [COMx [baud]]·disconnect COMx — 사람 전용: /connect-uart·/disconnect-uart skill 이 부른다. 인자는 그대로 넘긴다)
#
# 계약
#   1. exe: UART_HUB_EXE(Windows 경로 또는 /mnt/… 경로)가 있으면 그것, 없으면 아래 UART_HUB_EXE_DEFAULT(UartHub.exe 를 실행하면 새겨 넣는 한 줄 — 그 exe 의 경로).
#   2. 환경: $WSL_DISTRO_NAME 이 있거나 /proc/sys/fs/binfmt_misc/WSLInterop*(WSLInterop-late 포함)가 있으면 WSL,
#      uname -s 가 MINGW*|MSYS* 면 Git Bash, 아니면 103.
#   3. 인자(§2.3 l): printf '%s\0' "$@" | base64 를 base64url(패딩 없음)로 바꿔 `cli --b64nul <토큰>` 하나로 넘긴다(python3 불필요).
#      따옴표 · \ · $ · | · & · 한글 · 빈 인자 · '-'로 시작하는 인자가 다시 해석되지 않는다.
#   4. 경로(§2.3 m): WSL 은 UART_PATH_STYLE=wsl(/mnt/d/…), Git Bash 는 mixed(D:/…). `push <c> <local> <remote>` 의 <local> 은
#      wslpath -w / cygpath -w 로 바꾼다(위치 인자 판별은 ControlServer 와 같다: '--' 뒤는 모두 위치 인자, 값 옵션은 다음 인자를 먹는다).
#   5. 실행: WSL 은 표준 출력·오류를 가로채지 않고 exe 에 그대로 준다(tty·파이프 모두, 한글 보존 — K4). Git Bash 는 Windows 콘솔에서 WinExe 출력이
#      사라지므로 항상 `| cat` 경유 + PIPESTATUS. 종료코드는 exe 의 것(보드 rc 또는 100~106).
#   6. 호출 쪽 생존(K4 후속): WinExe 에는 TERM·INT 가 전달되지 않으므로 `cli --parent-pipe` 로 부르고, 이 래퍼가 쥔 파이프를 exe 의 표준 입력으로 준다
#      (`exec {fd}> >(exe …)` + `wait $!`). 래퍼가 TERM·INT·HUP 를 받거나 kill 되면 파이프가 닫혀 exe 가 EOF 를 보고 바로 103 으로 끝나고,
#      제어 연결이 닫혀 허브가 대기 중인 요청을 취소한다(보드로 미전송). 그래서 WSL 도 `exec` 로 래퍼를 바꿔치지 않는다.
# 환경변수: UART_HUB_DIR(/mnt/… 나 /c/… 면 Windows 경로로 바꿔 넘김) · UART_HUB_CONTROL_PORT · UART_PATH_STYLE(win|wsl|mixed)
#          UART_WRAPPER_ECHO=1  실행하지 않고 넘길 인자(stderr 에 줄마다 argv[i]=…)와 exe·토큰(stdout)만 찍는다(진단용).
set -uo pipefail
UART_HUB_EXE_DEFAULT=''

json_mode=0
for a in "$@"; do
  [[ "$a" == "--" ]] && break
  [[ "$a" == "--json" ]] && json_mode=1
done

# JSON 문자열(비ASCII·제어문자는 \uXXXX — CLI 의 Json.Str 과 같은 규칙)
json_str() {
  local LC_ALL=C.UTF-8 s=$1 out='' c o i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      '"') out+='\"' ;;
      '\') out+='\\' ;;
      *)
        printf -v o '%d' "'$c"
        if (( o < 0x20 || o > 0x7e )); then
          if (( o > 0xffff )); then
            o=$((o - 0x10000)); printf -v c '\\u%04x\\u%04x' $((0xd800 + (o >> 10))) $((0xdc00 + (o & 0x3ff)))
          else printf -v c '\\u%04x' "$o"; fi
        fi
        out+=$c ;;
    esac
  done
  printf '"%s"' "$out"
}

# 도구 오류(래퍼 단계): 비JSON 은 stderr 'uart: E10x …', --json 은 응답 형식 한 줄. 종료코드 = 코드.
fail() {
  local code=$1 status=$2 msg=$3
  if (( json_mode )); then printf '{"status":"%s","exit":%d,"error":%s}\n' "$status" "$code" "$(json_str "$msg")"
  else printf 'uart: E%d %s %s\n' "$code" "$status" "$msg" >&2; fi
  exit "$code"
}

# ---- 환경
envkind=''
if [[ -n "${WSL_DISTRO_NAME:-}" ]] || compgen -G '/proc/sys/fs/binfmt_misc/WSLInterop*' > /dev/null; then envkind=wsl
else case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*) envkind=gitbash ;; esac; fi
[[ -n "$envkind" ]] || fail 103 hub_down "WSL·Git Bash 가 아님 — Windows 의 UartHub.exe cli 를 직접 쓰세요 — Not WSL or Git Bash: run UartHub.exe cli on Windows directly"
if [[ $envkind == wsl ]]; then to_win() { wslpath -w "$1"; }; to_unix() { wslpath -u "$1"; }
else to_win() { cygpath -w "$1"; }; to_unix() { cygpath -u "$1"; }; fi

exe="${UART_HUB_EXE:-$UART_HUB_EXE_DEFAULT}"
[[ -n "$exe" ]] || fail 103 hub_down "UartHub.exe 경로 없음(UART_HUB_EXE 미설정, 래퍼에 새겨진 경로 없음) — UartHub.exe 를 더블클릭해 허브를 시작하세요 — No UartHub.exe path (UART_HUB_EXE not set, none stored in this wrapper): double-click UartHub.exe to start the hub"
if [[ "$exe" == /* ]]; then exe_u="$exe"; else exe_u="$(to_unix "$exe" 2>/dev/null)" || exe_u=""; fi
[[ -n "$exe_u" && -f "$exe_u" ]] || fail 103 hub_down "UartHub.exe 없음($exe) — exe 를 옮겼거나 지웠습니다. 둔 곳의 UartHub.exe 를 더블클릭하세요(경로를 다시 새김) — UartHub.exe not found ($exe): it was moved or deleted. Double-click UartHub.exe where it is now (stores the path again)"

# ---- 환경변수(Windows 프로세스에 넘김)
if [[ -n "${UART_HUB_DIR:-}" && "$UART_HUB_DIR" == /* ]]; then UART_HUB_DIR="$(to_win "$UART_HUB_DIR")"; fi
export UART_HUB_DIR="${UART_HUB_DIR:-}" UART_HUB_CONTROL_PORT="${UART_HUB_CONTROL_PORT:-}"
if [[ $envkind == wsl ]]; then
  export UART_PATH_STYLE="${UART_PATH_STYLE:-wsl}"
  mnt="$(wslpath -u 'C:\' 2>/dev/null)" || mnt="/mnt/c/"
  export UART_WSL_MOUNT="${mnt%c/}"
  export WSLENV="${WSLENV:+$WSLENV:}UART_HUB_DIR:UART_HUB_CONTROL_PORT:UART_PATH_STYLE:UART_WSL_MOUNT"
else
  export UART_PATH_STYLE="${UART_PATH_STYLE:-mixed}" MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
fi

# ---- push 의 <local>(명령 뒤 두 번째 위치 인자)을 Windows 경로로
args=("$@")
pos=() waiting=0 done=0
for ((i = 0; i < ${#args[@]}; i++)); do
  s=${args[i]}
  if (( waiting )); then waiting=0; continue; fi
  if (( !done )) && [[ "$s" == "--" ]]; then done=1; continue; fi
  if (( !done )) && [[ "$s" == --?* ]]; then
    case "$s" in --timeout|--idle|--req-id|--pattern|--since|--tail|--kind|--max) waiting=1 ;; esac   # ControlServer.Valued + events 의 --kind·--max 와 같게 유지
    continue
  fi
  pos+=("$i")
done
if (( ${#pos[@]} >= 3 )) && [[ "${args[${pos[0]}]}" == push ]]; then
  i=${pos[2]} p=${args[${pos[2]}]}
  if [[ -n "$p" && "$p" != \\\\* && ! "$p" =~ ^[A-Za-z]:[\\/] ]]; then
    w="$(to_win "$(realpath -ms -- "$p")" 2>/dev/null)" && args[i]="$w"      # 바꾸지 못하면 그대로 넘긴다(허브가 판단)
  fi
fi

if (( ${#args[@]} == 0 )); then tok=''
else tok="$(printf '%s\0' "${args[@]}" | base64 -w0 | tr '+/' '-_' | tr -d '=')"; fi

if [[ "${UART_WRAPPER_ECHO:-0}" == 1 ]]; then
  for ((i = 0; i < ${#args[@]}; i++)); do printf 'argv[%d]=%s\n' "$i" "${args[i]}" >&2; done
  echo "exe=$exe"
  echo "b64nul=$tok"
  exit 0
fi

cd /mnt/c 2>/dev/null || cd / 2>/dev/null || true      # Windows 프로세스 작업 폴더를 \\wsl.localhost 가 아닌 곳으로(경로 인자는 이미 절대 경로)
# 신호를 받으면 바로 끝낸다(trap 이 있어야 wait 가 즉시 돌아온다). 래퍼가 끝나면 parent 파이프의 쓰기 끝이 닫혀 exe 가 EOF → 103.
trap 'exit 143' TERM
trap 'exit 130' INT
trap 'exit 129' HUP
if [[ $envkind == wsl ]]; then
  exec {parent}> >(exec "$exe_u" cli --parent-pipe --b64nul "$tok")
else
  exec {parent}> >("$exe_u" cli --parent-pipe --b64nul "$tok" 2> >(cat >&2) | cat; exit "${PIPESTATUS[0]}")
fi
wait "$!"
exit $?
